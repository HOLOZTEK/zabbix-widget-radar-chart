{
	"manifest_version": 2.0,
	"id": "holoztek_radar_chart",
	"type": "widget",
	"name": "Radar Chart",
	"namespace": "HoloztekRadarChart",
	"author": "HOLOZTEK",
	"description": "Zabbix dashboard widget that visualizes multiple host item values as radar charts arranged in a grid layout.",
	"version": "1.1.0",
	"widget": {
		"size": {"width": 6, "height": 5},
		"js_class": "CWidgetHoloztekRadarChart",
		"in": {
			"groupids": {"type": "_hostgroupid"},
			"hostids": {"type": "_hostid"},
			"time_period": {"type": "_timeperiod"}
		}
	},
	"actions": {
		"widget.holoztek_radar_chart.view": {"class": "WidgetView"},
		"widget.holoztek_radar_chart.item.edit": {
			"class": "ItemEdit",
			"view": "item.edit",
			"layout": "layout.json"
		}
	},
	"assets": {
		"js": ["echarts.min.js", "class.widget.js"],
		"css": ["widget.css"]
	}
}
